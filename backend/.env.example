MONGO_URL=mongodb://localhost:27017
DB_NAME=fxcall
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"  (min 32 chars, rotate if ever leaked)
JWT_SECRET=
EMERGENT_EMAIL_KEY=
EMAIL_FROM_NAME=FX CALL
# Test-domain outbox for previews only. Ignored automatically when APP_ENV=production.
EMAIL_DEV_OUTBOX=false
CORS_ORIGINS=http://localhost:8081,http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
# production: hides /docs and /openapi.json, adds CSP, disables the dev outbox
APP_ENV=production
# Reverse proxies in front of the API (1 = one proxy/ingress, 2 = CDN + ingress, 0 = ignore X-Forwarded-For).
TRUSTED_PROXY_HOPS=1
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
